# Copy this file to credentials.env and fill in your own values.
# Never commit credentials.env.

# Discord bot token (Discord Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=your-discord-bot-token

# Trello API key and token (https://trello.com/power-ups/admin > your Power-Up > API key)
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token

# ID of the Trello board that holds your orders (open the board, add .json to the URL, copy "id")
TRELLO_BOARD_ID=your-trello-board-id
